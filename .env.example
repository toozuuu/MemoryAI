# MemoryAI Environment Configuration
MEMORYAI_ENV=production
MEMORYAI_DATA_DIR=/var/lib/memoryai
MEMORYAI_LOG_LEVEL=info
MEMORYAI_MAX_CONTEXT_TOKENS=1000
MEMORYAI_RATE_LIMIT=200
MEMORYAI_EMBEDDING_PROVIDER=local
MEMORYAI_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000

# Optional Cloud Provider keys (Leave empty for zero-dependency local mode)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
