{
  "name": "memoryai",
  "version": "1.0.0",
  "description": "Universal, local-first long-term memory CLI for AI agents (Cursor, Claude, MCP)",
  "keywords": [
    "memoryai",
    "mcp",
    "model-context-protocol",
    "cursor",
    "claude-code",
    "long-term-memory",
    "ai-agents",
    "sqlite-fts5"
  ],
  "homepage": "https://memoryai.github.io/memoryai/",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "memoryai": "dist/bin.js"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@memoryai/types": "^1.0.0",
    "@memoryai/core": "^1.0.0",
    "@memoryai/security": "^1.0.0",
    "@memoryai/storage-sqlite": "^1.0.0",
    "@memoryai/storage-memory-format": "^1.0.0"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
